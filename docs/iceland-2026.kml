.04783,63.40631 -19.04679,63.40482 -19.04446,63.40414 -19.04679,63.40482 -19.04783,63.40631 -19.04882,63.41823 -19.04783,63.41980 -19.05106,63.42534 -19.05134,63.42913 -19.05987,63.43779 -19.05920,63.44277 -19.04915,63.45248 -19.04881,63.45455 -19.05694,63.45410 -19.06176,63.45277 -19.06489,63.45475 -19.07537,63.45529 -19.08936,63.45347 -19.09637,63.45139 -19.10576,63.45028 -19.11541,63.44785 -19.13494,63.44697 -19.13859,63.44585 -19.14553,63.44115 -19.17668,63.43161 -19.18351,63.43168 -19.18942,63.43328 -19.19413,63.43722 -19.19006,63.43765</coordinates>
